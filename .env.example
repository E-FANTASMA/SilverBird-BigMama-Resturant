APP_NAME=Silverbird BigMama Restaurant
API_TITLE=Silverbird BigMama Restaurant API
API_DESCRIPTION=Backend API for the Silverbird BigMama Restaurant food ordering system.
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/silverbird_bigmama_restaurant
JWT_SECRET_KEY=change-me
JWT_REFRESH_SECRET_KEY=change-me-too
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PAYSTACK_SECRET_KEY=paystack-secret
PAYSTACK_PUBLIC_KEY=paystack-public
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_WEBHOOK_SECRET=paystack-webhook-secret
SUPABASE_URL=https://example.supabase.co
SUPABASE_SERVICE_ROLE_KEY=supabase-service-role-key
SUPABASE_BUCKET_NAME=food-images
RESTAURANT_NAME=Silverbird BigMama Restaurant
RESTAURANT_LATITUDE=6.4350
RESTAURANT_LONGITUDE=3.4219
DELIVERY_BASE_FEE=1000
DELIVERY_FEE_PER_KM=350
MAX_UPLOAD_SIZE_BYTES=5242880
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=noreply@example.com
SMTP_PASSWORD=secret
SMS_PROVIDER_API_KEY=sms-key
